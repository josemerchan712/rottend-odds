# Imagen de producción de la API. Construir desde la raíz del repositorio (necesita shared/):
#   docker build -f server/Dockerfile.prod -t rottenodds-api .
# La usa docker-compose.prod.yml; no publica puertos: solo Caddy llega a ella por la red interna.
FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY shared/ shared/
COPY server/.mvn/ server/.mvn/
COPY server/mvnw server/pom.xml server/
WORKDIR /app/server
RUN chmod +x mvnw && ./mvnw -B -q dependency:go-offline
COPY server/src/ src/
RUN ./mvnw -B -q package -DskipTests

FROM eclipse-temurin:21-jre
RUN groupadd --system casino && useradd --system --gid casino --no-create-home --shell /usr/sbin/nologin casino
WORKDIR /app
COPY --from=build --chown=root:root /app/server/target/casino-server-*.jar app.jar
USER casino
ENV SPRING_PROFILES_ACTIVE=prod \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/urandom"
EXPOSE 8080
# Sin curl en la imagen: petición HTTP mínima con bash a /health (200 y "ok" solo si llega a la base de datos).
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=4 \
  CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8080 && printf 'GET /health HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
