# Plantilla del .env de PRODUCCIÓN (docker-compose.prod.yml). Cópiala FUERA del repositorio, p. ej.:
#   install -m 600 .env.prod.example /opt/rottenodds/.env.prod
# y rellénala allí. Nunca la subas con valores reales.
#
# Generar valores aleatorios en el VPS (sin que se queden en el historial de la terminal):
#   openssl rand -base64 48 | tr -d '\n/+='   → para JWT_SECRET (64 caracteres)
#   openssl rand -base64 32 | tr -d '\n/+='   → para DB_PASSWORD

# Contraseña del usuario de PostgreSQL (solo la usan la API y la base de datos, en la red interna).
DB_PASSWORD=
# Opcional (por defecto casino)
# DB_USER=casino

# Secreto para firmar los JWT: 32 caracteres o más. Si cambia, todas las sesiones se cierran.
JWT_SECRET=

# Origen del juego (sin barra final). Solo desde ahí se puede llamar a la API desde el navegador.
CORS_ORIGINS=https://rottenodds.josemariamerchan.dev

# Dominio de la API: Caddy pide el certificado HTTPS para él. El DNS (registro A/AAAA) debe apuntar al VPS.
API_DOMAIN=rottenodds-api.josemariamerchan.dev
