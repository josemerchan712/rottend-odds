// Despliegue estático en Cloudflare (Workers con assets): solo sirve dist/, sin código de servidor.
// Comandos exactos en DEPLOY.md. No se despliega desde aquí.
{
  "name": "casino-incremental",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
  // Dominio personalizado (ver DEPLOY.md, paso 5): descomentar y poner el dominio propio.
  // "routes": [{ "pattern": "casino.example.com", "custom_domain": true }]
}
