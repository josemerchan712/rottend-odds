# Copia este archivo a .env y rellena los valores. .env está en .gitignore: nunca lo subas.

# Base de datos (docker-compose crea Postgres con estos datos)
DB_USER=casino
DB_PASSWORD=

# Secreto para firmar los JWT: 32 caracteres o más. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# Orígenes permitidos por CORS (separados por comas). El servidor de desarrollo de Vite:
CORS_ORIGINS=http://localhost:5173

# Opcional: intentos por IP y minuto en login, registro y restablecer contraseña (por defecto 10)
# AUTH_RATE_LIMIT=10
# Opcional: consultas por IP y minuto de «¿nombre disponible?» (por defecto 30)
# NAME_CHECK_RATE_LIMIT=30

# Frontend: URL del servidor. Sin ella el juego va sin servidor: oculta cuentas, sincronización y ranking
# (no usa localhost:8080). Para desarrollo, ponla en .env.development.local (Vite no la lee en el build).
VITE_API_URL=http://localhost:8080
