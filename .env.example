# Copia este archivo a .env y rellena los valores. .env está en .gitignore: nunca lo subas.

# Base de datos (docker-compose crea Postgres con estos datos)
DB_USER=casino
DB_PASSWORD=

# Secreto para firmar los JWT: 32 caracteres o más. Genera uno con:
#   openssl rand -base64 48
JWT_SECRET=

# Orígenes permitidos por CORS (separados por comas). El servidor de desarrollo de Vite:
CORS_ORIGINS=http://localhost:5173

# Opcional: intentos por IP y minuto en login y registro (por defecto 10)
# AUTH_RATE_LIMIT=10

# Frontend: URL del servidor. Si no se define, el juego usa http://localhost:8080
VITE_API_URL=http://localhost:8080
